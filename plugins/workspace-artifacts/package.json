{
  "name": "@birdman1992/workspace-artifacts",
  "version": "0.1.0",
  "description": "产物视图：在 Web 会话视图添加「产物」标签，浏览当前工作区文件树并查看文件内容（代码高亮 / Markdown 渲染）。",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "deepseek",
    "plugin",
    "workspace",
    "artifacts"
  ],
  "homepage": "https://github.com/birdman1992/dsh-birdman-plugins#readme",
  "bugs": {
    "url": "https://github.com/birdman1992/dsh-birdman-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-fs-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birdman1992/dsh-birdman-plugins.git",
    "directory": "plugins/workspace-artifacts"
  }
}
